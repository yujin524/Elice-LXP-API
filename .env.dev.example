# 이 파일을 복사해서 파일명을 .env.dev로 바꾼 뒤, 아래 값을 본인 것으로 채워주세요.
#   cp .env.dev.example .env.dev    (Mac/Linux)
#   copy .env.dev.example .env.dev  (Windows)
#
# .env.dev 파일은 .gitignore에 등록되어 있어 Git에 올라가지 않습니다.
# 반드시 .env.dev.example이 아니라 .env.dev 파일에 실제 값을 넣어주세요.
# 실행 시 ENV_FILE=".env.dev"로 지정해야 이 파일이 적용됩니다. (기본값은 .env)

# 로그인 계정 (필수) - 테스트 시작 시 이 계정으로 자동 로그인해서 access_token을 발급받습니다.
ELICE_ID=
ELICE_PW=

# --- classroom_edu / course_edu 학습자 계정 (권한 경계 테스트 전용) ---
# 위 DEV_LEARNER_A/B와는 별개로, classroom_edu/course_edu 전용 학습자 계정 1개입니다.
# 두 계정이 동시에 필요한 테스트는 없으므로 계정 1개만 있으면 됩니다.
# 비워두면 해당 계정이 필요한 테스트만 Skip됩니다.
LEARNER_ID=
LEARNER_PW=

# --- 권한 경계 테스트 계정 (선택, tests/api/board 전용) ---
# 비워두면 해당 역할 계정이 필요한 테스트만 Skip됩니다.
# classroom_edu / course_edu는 이 계정들을 쓰지 않습니다 (아래 LEARNER_ID 섹션 참고).
DEV_EDUCATOR_A_ID=
DEV_EDUCATOR_A_PW=
DEV_EDUCATOR_B_ID=
DEV_EDUCATOR_B_PW=
DEV_LEARNER_A_ID=
DEV_LEARNER_A_PW=
DEV_LEARNER_B_ID=
DEV_LEARNER_B_PW=
DEV_OUTSIDER_ID=
DEV_OUTSIDER_PW=
# Board 권한 테스트 전용 classroom ID (비우면 해당 테스트 Skip)
AUTHZ_CLASSROOM_ID=
# 운영(prod)에서 Board 권한/변경 테스트를 실행 허용할지 여부. TEST_ENV=prod일 때만 의미가 있고,
# dev에서는 무시되므로 false로 둡니다.
ALLOW_PROD_AUTHZ_MUTATION_TESTS=false

# --- 실행 환경 ---
TEST_ENV=dev

# --- API URL (필수) ---
API_BASE_URL=https://dev-qatrack-classroom-api.dev.elicer.io
REST_BASE_URL=https://dev-qatrack-api.dev.elicer.io
# course API는 별도 dev 엔드포인트가 없어 prod와 같은 주소를 그대로 씁니다.
COURSE_BASE_URL=https://api-course.elice.io
DASHBOARD_BASE_URL=https://dev-qatrack-dashboard-api.dev.elicer.io
EDU_REST_BASE_URL=https://dev-qatrack-api.dev.elicer.io
AUTH_URL=https://dev-qatrack-account-api.dev.elicer.io


# --- 공통 식별자 ---
ELICE_ORG_NAME_SHORT=academy

# --- classroom 조회 정책 ---
# dev 환경은 이름 조건 없이 접근 가능한 classroom 중 테스트 가능한 classroom을 선택합니다.
CLASSROOM_LOOKUP_MODE=available
CLASSROOM_REQUIRE_OPENED=true
CLASSROOM_REQUIRE_COURSE=true



