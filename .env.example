# 이 파일을 복사해서 파일명을 .env로 바꾼 뒤, 아래 값을 본인 것으로 채워주세요.
#   cp .env.example .env    (Mac/Linux)
#   copy .env.example .env  (Windows)
#
# .env 파일은 .gitignore에 등록되어 있어 Git에 올라가지 않습니다.
# 반드시 .env.example이 아니라 .env 파일에 실제 값을 넣어주세요.

# 로그인 계정 (필수) - 테스트 시작 시 이 계정으로 자동 로그인해서 access_token을 발급받습니다.
# (더 이상 브라우저에서 토큰을 직접 복사할 필요가 없습니다 - utils/auth_token.py가 처리합니다.)
ELICE_ID=
ELICE_PW=

# --- 실행 환경 ---
TEST_ENV=prod

# --- API URL (필수) ---
API_BASE_URL=https://api-classroom.elice.io
REST_BASE_URL=https://api-rest.elice.io
COURSE_BASE_URL=https://api-course.elice.io
DASHBOARD_BASE_URL=https://api-dashboard.elice.io
AUTH_URL=https://api-account.elice.io

# --- 공통 식별자 ---
ELICE_ORG_NAME_SHORT=qatrack

# --- classroom 조회 정책 ---
CLASSROOM_LOOKUP_MODE=name_keyword
CLASSROOM_NAME_KEYWORD=QA 트랙
CLASSROOM_REQUIRE_OPENED=false
CLASSROOM_REQUIRE_COURSE=false

# --- 요청 설정 ---
API_TIMEOUT_SECONDS=10
